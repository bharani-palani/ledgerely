{
  "security.workspace.trust.untrustedFiles": "open",
  "explorer.confirmDelete": false,
  "git.confirmSync": false,
  "emmet.showSuggestionsAsSnippets": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "calendar",
    "com_dotnet",
    "Core",
    "ctype",
    "curl",
    "date",
    "dba",
    "dom",
    "enchant",
    "exif",
    "FFI",
    "fileinfo",
    "filter",
    "fpm",
    "ftp",
    "gd",
    "gettext",
    "gmp",
    "hash",
    "iconv",
    "imap",
    "intl",
    "json",
    "ldap",
    "libxml",
    "mbstring",
    "meta",
    "mysqli",
    "oci8",
    "odbc",
    "openssl",
    "pcntl",
    "pcre",
    "PDO",
    "pdo_ibm",
    "pdo_mysql",
    "pdo_pgsql",
    "pdo_sqlite",
    "pgsql",
    "Phar",
    "posix",
    "pspell",
    "random",
    "readline",
    "Reflection",
    "session",
    "shmop",
    "SimpleXML",
    "snmp",
    "soap",
    "sockets",
    "sodium",
    "SPL",
    "sqlite3",
    "standard",
    "superglobals",
    "sysvmsg",
    "sysvsem",
    "sysvshm",
    "tidy",
    "tokenizer",
    "xml",
    "xmlreader",
    "xmlrpc",
    "xmlwriter",
    "xsl",
    "Zend OPcache",
    "zip",
    "zlib",
    "phpdbg"
  ],
  "php-intellisense.trace.server": "off",
  "php.suggest.basic": false,
  "intelephense.files.maxSize": 1000000,
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/android/**",
    "**/ios/**",
    "**/build/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/public/**",
    "**/assets/**",
    "**/icons/**",
    "**/services/system/**",
    "**/services/application/logs/**",
    "**/services/application/cache/**"
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/android/**": true,
    "**/ios/**": true,
    "**/build/**": true,
    "**/dev-dist/**": true
  },
  "search.exclude": {
    "**/dist*": true,
    "**/build*": true,
    "**/node_modules": true,
    "**/android": true,
    "**/ios": true
  },
  "files.exclude": {
    "**/stats.html": true
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "html.format.preserveNewLines": false,
  "php.validate.executablePath": "/Applications/MAMP/bin/php/php8.2.0/bin/php",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "window.zoomLevel": 0,
  "easycode.userEmail": "tp.bharani@gmail.com",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "never"
  },
  "prettier.htmlWhitespaceSensitivity": "strict",
  "intelephense.diagnostics.undefinedProperties": false,
  "workbench.editor.empty.hint": "hidden",
  "[php]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.svg": "html"
  },
  "editor.showUnused": true
}
